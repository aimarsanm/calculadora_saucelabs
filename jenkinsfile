pipeline {
    agent {
        label "zuvmljenson02"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    parameters {
        hidden(
            name: 'JOB_ACTION',
            defaultValue: 'ci',
            description: 'SonarQube Enterprise'
        )
    }

    environment {
        PROJECT_NAME = 'Pipeline Calculadora Prueba'
        PROJECT_KEY = 'pipeline-calculadora-prueba'
        PROJECT_VERSION = '1.0.0'
        PYTHON_VERSION = '3.12'

        IMAGE_PYTHON = 'registry.lksnext.com/devsecops/python3_12:1.2'
        IMAGE_SONARSCANNER = 'sonarsource/sonar-scanner-cli:latest'

        SONAR_ENTERPRISE_URL = 'https://sonarqubeenterprise.devops.lksnext.com'
        GITLAB_API_URL = 'https://gitlab.devops.lksnext.com/api/v4'
        SONAR_TOKEN = credentials('sonarenterprise-analysis-token')
        GITLAB_MERGE_REQUEST_IID = "${env.gitlabMergeRequestIid ?: ''}"
    }

    stages {
        stage('Git Checkout') {
            steps {
                sh '''
                    set -eu

                    echo "Reparando permisos del workspace..."

                    docker run --rm \
                        --user 0:0 \
                        -v "${WORKSPACE}:/workspace" \
                        -e HOST_UID="$(id -u)" \
                        -e HOST_GID="$(id -g)" \
                        "${IMAGE_PYTHON}" \
                        sh -ceu '
                            chown -R "${HOST_UID}:${HOST_GID}" /workspace
                            chmod -R u+rwX /workspace
                        '
                '''

                deleteDir()
                checkout scm
            }
        }

        stage('Tests') {
            when {
                environment name: 'JOB_ACTION', value: 'ci'
            }

            steps {
                sh '''
                    set -eu

                    echo "Ejecutando tests de la calculadora en Docker..."

                    docker run --rm \
                        --user 0:0 \
                        -v "${WORKSPACE}:/app" \
                        -w /app \
                        -e HOST_UID="$(id -u)" \
                        -e HOST_GID="$(id -g)" \
                        "${IMAGE_PYTHON}" \
                        sh -ceu '
                            python -m pip install --user pytest pytest-cov
                            export PATH="$HOME/.local/bin:$PATH"

                            python -m pytest \
                                tests/ \
                                -v \
                                --tb=long \
                                --maxfail=20 \
                                --cov=src \
                                --cov-report=xml:/app/coverage.xml \
                                --junitxml=/app/junit-results.xml

                            test -s /app/coverage.xml
                            echo "Coverage generado correctamente."

                            chown -R "${HOST_UID}:${HOST_GID}" /app
                            chmod -R u+rwX /app
                        '

                    test -s "${WORKSPACE}/coverage.xml"
                    echo "Coverage disponible en el workspace."
                '''
            }
        }

        stage('SonarQube Analysis') {
            when {
                environment name: 'JOB_ACTION', value: 'ci'
            }

            steps {
                script {
                    echo "Enviando análisis a SonarQube LKS..."

                    sh '''
                        set -eu

                        test -s "${WORKSPACE}/coverage.xml"

                        docker run --rm \
                            --user 0:0 \
                            --entrypoint /bin/sh \
                            -v "${WORKSPACE}:/app" \
                            -e SONAR_HOST_URL="${SONAR_ENTERPRISE_URL}" \
                            -e SONAR_TOKEN="${SONAR_TOKEN}" \
                            -e SONAR_USER_HOME=/tmp \
                            -e PROJECT_KEY="${PROJECT_KEY}" \
                            -e PROJECT_NAME="${PROJECT_NAME}" \
                            -e PROJECT_VERSION="${PROJECT_VERSION}" \
                            -e PYTHON_VERSION="${PYTHON_VERSION}" \
                            "${IMAGE_SONARSCANNER}" \
                            -ceu '
                                if command -v apk >/dev/null 2>&1; then
                                    apk add --no-cache python3 py3-virtualenv npm
                                elif command -v apt-get >/dev/null 2>&1; then
                                    apt-get update
                                    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
                                        python3 python3-venv python3-pip virtualenv npm
                                    rm -rf /var/lib/apt/lists/*
                                elif command -v microdnf >/dev/null 2>&1; then
                                    microdnf install -y python3 python3-pip python3-virtualenv npm
                                    microdnf clean all
                                elif command -v dnf >/dev/null 2>&1; then
                                    dnf install -y python3 python3-pip python3-virtualenv npm
                                    dnf clean all
                                else
                                    echo "ERROR: no compatible package manager in scanner image"
                                    exit 1
                                fi

                                if command -v sonar-scanner >/dev/null 2>&1; then
                                    SONAR_SCANNER=sonar-scanner
                                elif [ -x /opt/sonar-scanner/bin/sonar-scanner ]; then
                                    SONAR_SCANNER=/opt/sonar-scanner/bin/sonar-scanner
                                else
                                    SONAR_SCANNER=$(find /opt -type f -name sonar-scanner -perm -111 -print -quit 2>/dev/null)
                                fi

                                if [ -z "${SONAR_SCANNER}" ]; then
                                    echo "ERROR: sonar-scanner executable not found"
                                    exit 1
                                fi

                                SONAR_PR_ARGS=""
                                if [ -n "${GITLAB_MERGE_REQUEST_IID:-}" ]; then
                                    SONAR_PR_ARGS="\
                                        -Dsonar.pullrequest.key=${GITLAB_MERGE_REQUEST_IID} \
                                        -Dsonar.pullrequest.branch=${GITLAB_SOURCE_BRANCH:-HEAD} \
                                        -Dsonar.pullrequest.base=${GITLAB_TARGET_BRANCH:-main}"
                                fi

                                "${SONAR_SCANNER}" \
                                    -Dsonar.projectKey="${PROJECT_KEY}" \
                                    -Dsonar.projectName="${PROJECT_NAME}" \
                                    -Dsonar.projectVersion="${PROJECT_VERSION}" \
                                    -Dsonar.projectBaseDir=/app \
                                    -Dsonar.sources=/app/src \
                                    -Dsonar.tests=/app/tests \
                                    -Dsonar.python.version="${PYTHON_VERSION}" \
                                    -Dsonar.python.coverage.reportPaths=/app/coverage.xml \
                                    -Dsonar.exclusions="**/__pycache__/**" \
                                    -Dsonar.scm.provider=git \
                                    ${SONAR_PR_ARGS}
                            '
                    '''
                }
            }
        }
        stage('Fetch Sonar MR Summary Metrics') {
            when {
                expression { return env.GITLAB_MERGE_REQUEST_IID }
            }

            steps {
                script {
                    def qgResp = sh(
                        script: """
                            curl -fsS -u "${env.SONAR_TOKEN}:" \\
                            "${env.SONAR_ENTERPRISE_URL}/api/qualitygates/project_status?projectKey=${env.PROJECT_KEY}&pullRequest=${env.GITLAB_MERGE_REQUEST_IID}"
                        """,
                        returnStdout: true
                    ).trim()

                    def status = sh(
                        script: "printf '%s' '${qgResp}' | jq -r '.projectStatus.status // \"UNKNOWN\"'",
                        returnStdout: true
                    ).trim()

                    if (status == 'OK') {
                        env.GATE_HEADER = 'Quality Gate passed'
                    } else if (status == 'WARN') {
                        env.GATE_HEADER = 'Quality Gate passed with warnings'
                    } else {
                        env.GATE_HEADER = 'Quality Gate failed'
                    }

                    def metricsResp = sh(
                        script: """
                            curl -fsS -u "${env.SONAR_TOKEN}:" \\
                            "${env.SONAR_ENTERPRISE_URL}/api/measures/component?component=${env.PROJECT_KEY}&pullRequest=${env.GITLAB_MERGE_REQUEST_IID}&metricKeys=new_violations,new_bugs,new_reliability_rating,new_vulnerabilities,new_security_rating,new_code_smells,new_maintainability_rating,new_coverage,new_duplicated_lines_density,new_security_hotspots"
                        """,
                        returnStdout: true
                    ).trim()

                    def metric = { key, fallback ->
                        sh(
                            script: "printf '%s' '${metricsResp}' | jq -r '.component.measures[]? | select(.metric==\"${key}\") | (.period.value // .periods[0].value // .value // \"${fallback}\")'",
                            returnStdout: true
                        ).trim()
                    }

                    env.M_NEW_ISSUES = metric('new_violations', '0')
                    env.M_NEW_BUGS = metric('new_bugs', '0')
                    env.M_NEW_VULNERABILITIES = metric('new_vulnerabilities', '0')
                    env.M_NEW_CODE_SMELLS = metric('new_code_smells', '0')
                    env.M_SECURITY_HOTSPOTS = metric('new_security_hotspots', '0')
                    env.M_COVERAGE = metric('new_coverage', 'N/A')
                    env.M_DUPLICATIONS = metric('new_duplicated_lines_density', '-')
                    env.M_NEW_RELIABILITY_RATING = metric('new_reliability_rating', 'N/A')
                    env.M_NEW_SECURITY_RATING = metric('new_security_rating', 'N/A')
                    env.M_NEW_MAINTAINABILITY_RATING = metric('new_maintainability_rating', 'N/A')
                }
            }
        }

        stage('Comment MR') {
            when {
                expression { return env.GITLAB_MERGE_REQUEST_IID }
            }

            steps {
                script {
                    def commentBody = """### ${env.GATE_HEADER}

| Metric | Value |
| :--- | :--- |
| New Issues | ${env.M_NEW_ISSUES} |
| New Bugs | ${env.M_NEW_BUGS} |
| New Vulnerabilities | ${env.M_NEW_VULNERABILITIES} |
| New Code Smells | ${env.M_NEW_CODE_SMELLS} |
| Coverage | ${env.M_COVERAGE} |
| Duplications | ${env.M_DUPLICATIONS} |
| Security Hotspots | ${env.M_SECURITY_HOTSPOTS} |

[View SonarQube analysis](${env.SONAR_ENTERPRISE_URL}/dashboard?id=${env.PROJECT_KEY}&pullRequest=${env.GITLAB_MERGE_REQUEST_IID})"""

                    withCredentials([string(credentialsId: 'GITLAB_TOKEN', variable: 'GITLAB_TOKEN')]) {
                        sh """
                            set -eu
                            PROJECT_ID=\"\${GITLAB_PROJECT_ID:-\${CI_PROJECT_ID:-}}\"
                            test -n \"\${PROJECT_ID}\" || { echo 'GitLab project ID is not available'; exit 1; }
                            PAYLOAD=\$(jq -n --arg body \"${commentBody}\" '{body: \\$body}')
                            curl -fsS \\
                                -H \"PRIVATE-TOKEN: \${GITLAB_TOKEN}\" \\
                                -H \"Content-Type: application/json\" \\
                                -X POST \\
                                -d \"\$PAYLOAD\" \\
                                \"${env.GITLAB_API_URL}/projects/\${PROJECT_ID}/merge_requests/${env.GITLAB_MERGE_REQUEST_IID}/notes\"
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            sh '''
                set +e

                docker run --rm \
                    --user 0:0 \
                    -v "${WORKSPACE}:/workspace" \
                    -e HOST_UID="$(id -u)" \
                    -e HOST_GID="$(id -g)" \
                    "${IMAGE_PYTHON}" \
                    sh -ceu '
                        chown -R "${HOST_UID}:${HOST_GID}" /workspace
                        chmod -R u+rwX /workspace
                    '
            '''

            archiveArtifacts(
                artifacts: 'coverage.xml,junit-results.xml',
                allowEmptyArchive: true
            )

        }

        success {
            echo "Pipeline ejecutado exitosamente"
        }

        failure {
            echo "Pipeline falló"
        }
    }
}
pipeline {
    agent {
        label "zuvmljenson02"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    parameters {
        hidden(
            name: 'JOB_ACTION',
            defaultValue: 'ci',
            description: 'SonarQube Enterprise'
        )
    }

    environment {
        PROJECT_NAME = 'Pipeline Calculadora Prueba'
        PROJECT_KEY = 'pipeline-calculadora-prueba'
        PROJECT_VERSION = '1.0.0'
        PYTHON_VERSION = '3.12'

        IMAGE_PYTHON = 'registry.lksnext.com/devsecops/python3_12:1.2'
        IMAGE_SONARSCANNER = 'sonarsource/sonar-scanner-cli:latest'

        SONAR_ENTERPRISE_URL = 'https://sonarqubeenterprise.devops.lksnext.com'
        GITLAB_API_URL = 'https://gitlab.devops.lksnext.com/api/v4'
        SONAR_TOKEN = credentials('sonarenterprise-analysis-token')
        
        GITLAB_MERGE_REQUEST_IID = "${env.gitlabMergeRequestIid ?: env.GITLAB_MERGE_REQUEST_IID ?: ''}"
        GITLAB_SOURCE_BRANCH = "${env.gitlabSourceBranch ?: env.GITLAB_SOURCE_BRANCH ?: ''}"
        GITLAB_TARGET_BRANCH = "${env.gitlabTargetBranch ?: env.GITLAB_TARGET_BRANCH ?: ''}"
    }   

    stages {
        stage('Git Checkout') {
            steps {
                sh '''
                    set -eu

                    echo "Reparando permisos del workspace..."

                    docker run --rm \
                        --user 0:0 \
                        -v "${WORKSPACE}:/workspace" \
                        -e HOST_UID="$(id -u)" \
                        -e HOST_GID="$(id -g)" \
                        "${IMAGE_PYTHON}" \
                        sh -ceu '
                            chown -R "${HOST_UID}:${HOST_GID}" /workspace
                            chmod -R u+rwX /workspace
                        '
                '''

                deleteDir()
                checkout scm
            }
        }

        stage('Tests') {
            when {
                environment name: 'JOB_ACTION', value: 'ci'
            }

            steps {
                sh '''
                    set -eu

                    echo "Ejecutando tests de la calculadora en Docker..."

                    docker run --rm \
                        --user 0:0 \
                        -v "${WORKSPACE}:/app" \
                        -w /app \
                        -e HOST_UID="$(id -u)" \
                        -e HOST_GID="$(id -g)" \
                        "${IMAGE_PYTHON}" \
                        sh -ceu '
                            python -m pip install --user pytest pytest-cov
                            export PATH="$HOME/.local/bin:$PATH"

                            python -m pytest \
                                tests/ \
                                -v \
                                --tb=long \
                                --maxfail=20 \
                                --cov=src \
                                --cov-report=xml:/app/coverage.xml \
                                --junitxml=/app/junit-results.xml

                            test -s /app/coverage.xml
                            echo "Coverage generado correctamente."

                            chown -R "${HOST_UID}:${HOST_GID}" /app
                            chmod -R u+rwX /app
                        '

                    test -s "${WORKSPACE}/coverage.xml"
                    echo "Coverage disponible en el workspace."
                '''
            }
        }

        stage('SonarQube Analysis') {
            when {
                environment name: 'JOB_ACTION', value: 'ci'
            }

            steps {
                script {
                    echo "Enviando análisis a SonarQube LKS..."

                    sh '''
                        set -eu

                        test -s "${WORKSPACE}/coverage.xml"

                        docker run --rm \
                            --user 0:0 \
                            --entrypoint /bin/sh \
                            -v "${WORKSPACE}:/app" \
                            -e SONAR_HOST_URL="${SONAR_ENTERPRISE_URL}" \
                            -e SONAR_TOKEN="${SONAR_TOKEN}" \
                            -e SONAR_USER_HOME=/tmp \
                            -e PROJECT_KEY="${PROJECT_KEY}" \
                            -e PROJECT_NAME="${PROJECT_NAME}" \
                            -e PROJECT_VERSION="${PROJECT_VERSION}" \
                            -e PYTHON_VERSION="${PYTHON_VERSION}" \
                            -e GITLAB_MERGE_REQUEST_IID="${GITLAB_MERGE_REQUEST_IID}" \
                            -e GITLAB_SOURCE_BRANCH="${GITLAB_SOURCE_BRANCH}" \
                            -e GITLAB_TARGET_BRANCH="${GITLAB_TARGET_BRANCH}" \
                            "${IMAGE_SONARSCANNER}" \
                            -ceu '
                                if command -v apk >/dev/null 2>&1; then
                                    apk add --no-cache python3 py3-virtualenv npm
                                elif command -v apt-get >/dev/null 2>&1; then
                                    apt-get update
                                    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
                                        python3 python3-venv python3-pip virtualenv npm
                                    rm -rf /var/lib/apt/lists/*
                                elif command -v microdnf >/dev/null 2>&1; then
                                    microdnf install -y python3 python3-pip python3-virtualenv npm
                                    microdnf clean all
                                elif command -v dnf >/dev/null 2>&1; then
                                    dnf install -y python3 python3-pip python3-virtualenv npm
                                    dnf clean all
                                else
                                    echo "ERROR: no compatible package manager in scanner image"
                                    exit 1
                                fi

                                if command -v sonar-scanner >/dev/null 2>&1; then
                                    SONAR_SCANNER=sonar-scanner
                                elif [ -x /opt/sonar-scanner/bin/sonar-scanner ]; then
                                    SONAR_SCANNER=/opt/sonar-scanner/bin/sonar-scanner
                                else
                                    SONAR_SCANNER=$(find /opt -type f -name sonar-scanner -perm -111 -print -quit 2>/dev/null)
                                fi

                                if [ -z "${SONAR_SCANNER}" ]; then
                                    echo "ERROR: sonar-scanner executable not found"
                                    exit 1
                                fi

                                SONAR_PR_ARGS=""
                                if [ -n "${GITLAB_MERGE_REQUEST_IID:-}" ]; then
                                    SONAR_PR_ARGS="\
                                        -Dsonar.pullrequest.key=${GITLAB_MERGE_REQUEST_IID} \
                                        -Dsonar.pullrequest.branch=${GITLAB_SOURCE_BRANCH:-HEAD} \
                                        -Dsonar.pullrequest.base=${GITLAB_TARGET_BRANCH:-main}"
                                fi

                                "${SONAR_SCANNER}" \
                                    -Dsonar.projectKey="${PROJECT_KEY}" \
                                    -Dsonar.projectName="${PROJECT_NAME}" \
                                    -Dsonar.projectVersion="${PROJECT_VERSION}" \
                                    -Dsonar.projectBaseDir=/app \
                                    -Dsonar.sources=/app/src \
                                    -Dsonar.tests=/app/tests \
                                    -Dsonar.python.version="${PYTHON_VERSION}" \
                                    -Dsonar.python.coverage.reportPaths=/app/coverage.xml \
                                    -Dsonar.exclusions="**/__pycache__/**" \
                                    -Dsonar.scm.provider=git \
                                    ${SONAR_PR_ARGS}
                            '
                    '''
                }
            }
        }

        stage('Fetch Sonar MR Summary Metrics') {
            when {
                expression { return env.GITLAB_MERGE_REQUEST_IID }
            }

            steps {
                script {
                    sh '''
                        set -eu

                        docker run --rm \
                            -e SONAR_TOKEN="${SONAR_TOKEN}" \
                            -e SONAR_ENTERPRISE_URL="${SONAR_ENTERPRISE_URL}" \
                            -e PROJECT_KEY="${PROJECT_KEY}" \
                            -e GITLAB_MERGE_REQUEST_IID="${GITLAB_MERGE_REQUEST_IID}" \
                            -v "${WORKSPACE}:/workspace" \
                            "${IMAGE_PYTHON}" \
                            python3 -c "import os, urllib.request, json
sonar_url = os.environ['SONAR_ENTERPRISE_URL']
token = os.environ['SONAR_TOKEN']
project = os.environ['PROJECT_KEY']
pr = os.environ['GITLAB_MERGE_REQUEST_IID']
headers = {'Authorization': 'Bearer ' + token}

qg_url = f'{sonar_url}/api/qualitygates/project_status?projectKey={project}&pullRequest={pr}'
req = urllib.request.Request(qg_url, headers=headers)
with urllib.request.urlopen(req) as resp:
    qg_data = json.loads(resp.read().decode())

status = qg_data.get('projectStatus', {}).get('status', 'UNKNOWN')
gate_header = 'Quality Gate passed' if status == 'OK' else ('Quality Gate passed with warnings' if status == 'WARN' else 'Quality Gate failed')

metrics_url = f'{sonar_url}/api/measures/component?component={project}&pullRequest={pr}&metricKeys=new_violations,new_bugs,new_vulnerabilities,new_code_smells,new_coverage,new_duplicated_lines_density,new_security_hotspots'
req_m = urllib.request.Request(metrics_url, headers=headers)
with urllib.request.urlopen(req_m) as resp:
    metrics_data = json.loads(resp.read().decode())

measures = metrics_data.get('component', {}).get('measures', [])
def get_metric(key, fallback):
    for m in measures:
        if m.get('metric') == key:
            if 'period' in m and 'value' in m['period']:
                return m['period']['value']
            if 'periods' in m and len(m['periods']) > 0:
                return m['periods'][0].get('value', fallback)
            return m.get('value', fallback)
    return fallback

env_vars = {
    'GATE_HEADER': gate_header,
    'M_NEW_ISSUES': get_metric('new_violations', '0'),
    'M_NEW_BUGS': get_metric('new_bugs', '0'),
    'M_NEW_VULNERABILITIES': get_metric('new_vulnerabilities', '0'),
    'M_NEW_CODE_SMELLS': get_metric('new_code_smells', '0'),
    'M_SECURITY_HOTSPOTS': get_metric('new_security_hotspots', '0'),
    'M_COVERAGE': get_metric('new_coverage', 'N/A'),
    'M_DUPLICATIONS': get_metric('new_duplicated_lines_density', '-')
}

with open('/workspace/sonar_metrics.env', 'w') as f:
    for k, v in env_vars.items():
        f.write(f'{k}={v}\\n')
"
                    '''

                    def envFile = readFile("${WORKSPACE}/sonar_metrics.env")
                    for (String line : envFile.readLines()) {
                        int separator = line.indexOf('=')
                        if (separator > 0) {
                            String key = line.substring(0, separator)
                            String value = line.substring(separator + 1)
                            if (value) env."${key}" = value
                        }
                    }
                }
            }
        }

        stage('Comment MR') {
            when {
                expression { return env.GITLAB_MERGE_REQUEST_IID != '' }
            }

            steps {
                script {
                    withCredentials([string(credentialsId: 'GITLAB_TOKEN', variable: 'GITLAB_TOKEN')]) {
                        sh '''
                            set -eu

                            docker run --rm \
                                -e GITLAB_TOKEN="${GITLAB_TOKEN}" \
                                -e GITLAB_API_URL="${GITLAB_API_URL}" \
                                -e GITLAB_PROJECT_ID="${GITLAB_PROJECT_ID:-${CI_PROJECT_ID:-}}" \
                                -e GITLAB_MERGE_REQUEST_IID="${GITLAB_MERGE_REQUEST_IID}" \
                                -e GATE_HEADER="${GATE_HEADER}" \
                                -e M_NEW_ISSUES="${M_NEW_ISSUES}" \
                                -e M_NEW_BUGS="${M_NEW_BUGS}" \
                                -e M_NEW_VULNERABILITIES="${M_NEW_VULNERABILITIES}" \
                                -e M_NEW_CODE_SMELLS="${M_NEW_CODE_SMELLS}" \
                                -e M_COVERAGE="${M_COVERAGE}" \
                                -e M_DUPLICATIONS="${M_DUPLICATIONS}" \
                                -e M_SECURITY_HOTSPOTS="${M_SECURITY_HOTSPOTS}" \
                                -e SONAR_ENTERPRISE_URL="${SONAR_ENTERPRISE_URL}" \
                                -e PROJECT_KEY="${PROJECT_KEY}" \
                                "${IMAGE_PYTHON}" \
                                python3 -c "import os, urllib.request, json
project_id = os.environ.get('GITLAB_PROJECT_ID')
mr_iid = os.environ.get('GITLAB_MERGE_REQUEST_IID')
gitlab_url = os.environ.get('GITLAB_API_URL')
token = os.environ.get('GITLAB_TOKEN')

comment_body = """### {gate_header}

| Metric | Value |
| :--- | :--- |
| New Issues | {issues} |
| New Bugs | {bugs} |
| New Vulnerabilities | {vulns} |
| New Code Smells | {smells} |
| Coverage | {cov} |
| Duplications | {dups} |
| Security Hotspots | {hotspots} |

[View SonarQube analysis]({sonar_url}/dashboard?id={project_key}&pullRequest={mr_iid})""".format(
    gate_header=os.environ.get('GATE_HEADER'),
    issues=os.environ.get('M_NEW_ISSUES'),
    bugs=os.environ.get('M_NEW_BUGS'),
    vulns=os.environ.get('M_NEW_VULNERABILITIES'),
    smells=os.environ.get('M_NEW_CODE_SMELLS'),
    cov=os.environ.get('M_COVERAGE'),
    dups=os.environ.get('M_DUPLICATIONS'),
    hotspots=os.environ.get('M_SECURITY_HOTSPOTS'),
    sonar_url=os.environ.get('SONAR_ENTERPRISE_URL'),
    project_key=os.environ.get('PROJECT_KEY'),
    mr_iid=mr_iid
)

url = f'{gitlab_url}/projects/{project_id}/merge_requests/{mr_iid}/notes'
headers = {'PRIVATE-TOKEN': token, 'Content-Type': 'application/json'}
data = json.dumps({'body': comment_body}).encode('utf-8')
req = urllib.request.Request(url, data=data, headers=headers, method='POST')
with urllib.request.urlopen(req) as resp:
    print('Comentario enviado correctamente a GitLab.')
"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh '''
                set +e

                docker run --rm \
                    --user 0:0 \
                    -v "${WORKSPACE}:/workspace" \
                    -e HOST_UID="$(id -u)" \
                    -e HOST_GID="$(id -g)" \
                    "${IMAGE_PYTHON}" \
                    sh -ceu '
                        chown -R "${HOST_UID}:${HOST_GID}" /workspace
                        chmod -R u+rwX /workspace
                    '
            '''

            archiveArtifacts(
                artifacts: 'coverage.xml,junit-results.xml',
                allowEmptyArchive: true
            )
        }

        success {
            echo "Pipeline ejecutado exitosamente"
        }

        failure {
            echo "Pipeline falló"
        }
    }
}